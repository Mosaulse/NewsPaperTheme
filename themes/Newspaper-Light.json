  "tokenColors": [
    {
      "scope": "comment, comment.block, comment.line, comment.block.documentation",
      "settings": {
        "foreground": "#4a5e3a",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "keyword, keyword.control, storage.type, storage.modifier",
      "settings": {
        "foreground": "#2c6e8c",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "keyword.operator, keyword.operator.assignment, keyword.operator.arithmetic, keyword.operator.logical",
      "settings": {
        "foreground": "#555555"
      }
    },
    {
      "scope": "string, string.quoted, string.quoted.single, string.quoted.double, string.regexp",
      "settings": {
        "foreground": "#5c4033"
      }
    },
    {
      "scope": "constant.numeric, constant.numeric.integer, constant.numeric.float",
      "settings": {
        "foreground": "#8b1a1a"
      }
    },
    {
      "scope": "constant.language, constant.language.boolean, constant.language.null",
      "settings": {
        "foreground": "#8b6914"
      }
    },
    {
      "scope": "variable, variable.other, variable.other.readwrite",
      "settings": {
        "foreground": "#3a3530"
      }
    },
    {
      "scope": "variable.other.constant, variable.language.special",
      "settings": {
        "foreground": "#8b1a1a"
      }
    },
    {
      "scope": "entity.name.function, support.function, meta.function-call",
      "settings": {
        "foreground": "#1a1a1a",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "entity.name.type, entity.name.class, entity.name.struct, entity.name.interface, support.type",
      "settings": {
        "foreground": "#2c6e8c"
      }
    },
    {
      "scope": "support.constant, constant.other",
      "settings": {
        "foreground": "#8b6914"
      }
    },
    {
      "scope": "punctuation, punctuation.separator, punctuation.definition, meta.brace",
      "settings": {
        "foreground": "#888888"
      }
    },
    {
      "scope": "invalid, invalid.illegal, invalid.broken, invalid.deprecated",
      "settings": {
        "foreground": "#c41e1e",
        "fontStyle": "underline"
      }
    },
    {
      "scope": "markup.inserted, meta.diff.header.from-file, markup.inserted",
      "settings": {
        "foreground": "#2c6e8c"
      }
    },
    {
      "scope": "markup.deleted, meta.diff.header.to-file, markup.deleted",
      "settings": {
        "foreground": "#c41e1e"
      }
    },
    {
      "scope": "markup.heading, markup.heading.markdown",
      "settings": {
        "foreground": "#1a1a1a",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.underline.link, markup.underline",
      "settings": {
        "foreground": "#2c6e8c",
        "fontStyle": "underline"
      }
    },
    {
      "scope": "markup.list, markup.list.unordered, markup.list.ordered",
      "settings": {
        "foreground": "#5c4033"
      }
    },
    {
      "scope": "entity.name.tag, meta.tag, punctuation.definition.tag",
      "settings": {
        "foreground": "#6b3a2a"
      }
    },
    {
      "scope": "entity.other.attribute-name, entity.other.attribute-name.class, entity.other.attribute-name.id",
      "settings": {
        "foreground": "#8b6914"
      }
    },
    {
      "scope": "string.quoted.double constant.character.escape, constant.character.escape, constant.character.escape.html",
      "settings": {
        "foreground": "#8b1a1a"
      }
    },
    {
      "scope": "support.type.property-name, variable.other.property, meta.property-name",
      "settings": {
        "foreground": "#3a3530"
      }
    },
    {
      "scope": "markup.table, markup.table.markdown",
      "settings": {
        "foreground": "#1a1a1a"
      }
    }
  ]
}
